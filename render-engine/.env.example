# Copy to .env and fill in. .env is gitignored — never commit it, never copy it to a pod.

# RunPod API key: console.runpod.io -> Settings -> API Keys
RUNPOD_API_KEY=

# Network volume holding ComfyUI + ~50-75 GB of weights.
# Create it BEFORE the first pod, in a region that stocks RTX 5090s — the volume pins
# you to its datacenter.
RUNPOD_NETWORK_VOLUME_ID=

# LTX-2.3 needs 32 GB+ VRAM. The 5090 has exactly 32 GB, so this is the floor, not a
# preference. A 4090 (24 GB) only works via the node repo's low_vram_loaders/FP8 path.
RUNPOD_GPU_TYPE_ID=NVIDIA GeForce RTX 5090

# Where the client reaches ComfyUI. Default assumes the SSH tunnel:
#   ssh -N -L 8188:localhost:8188 root@<pod-ip> -p <ssh-port>
# Pointing this at *.proxy.runpod.net works but publishes an UNAUTHENTICATED ComfyUI.
COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# Generation geometry. Output is upscaled to 1080x1920 during assembly; asking the model
# for that directly is slower and not better.
GEN_WIDTH=768
GEN_HEIGHT=512
GEN_FRAMES=97
