    {
      "parameters": {
        "jsCode": "// HTTP Request nodes drop input binaries, so re-attach the mp4 for the PUT.\nconst item = $input.first();\nconst src = $('Read Video File').first().binary?.Horrorvideo;\nif (!src) throw new Error('Horrorvideo binary missing');\nif (!item.json.data?.upload_url) throw new Error('TikTok init returned no upload_url: ' + JSON.stringify(item.json).slice(0, 500));\nreturn [{ json: item.json, binary: { Horrorvideo: { ...src, mimeType: 'video/mp4', fileType: 'video/mp4', fileExtension: 'mp4' } } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3256,
        1040
